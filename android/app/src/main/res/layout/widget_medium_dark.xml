<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_surface_dark"
    android:orientation="vertical"
    android:padding="5dp">

    <!-- Medium (default 4x2, about 112 dp minimum): the same figures as the Large widget, shorter. No progress bars and no percentages;
         the macro cards show grams only. Same RemoteViews-compatible classes as the Large layout. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/widget_intake_card"
            style="@style/WidgetCardRow"
            android:layout_width="0dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/widget_card_intake_dark">
            <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/widget_intake_icon_dark" />
            <TextView
                android:id="@+id/widget_intake_value"
                style="@style/WidgetValueRow"
                android:textColor="#E6F8EB" />
            <TextView
                    android:id="@+id/widget_intake_net"
                    style="@style/WidgetPill"
                    android:background="@drawable/widget_pill_surplus_dark"
                    android:textColor="#17432A"
                    android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_burned_card"
            style="@style/WidgetCardRow"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:background="@drawable/widget_card_burned_dark">
            <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/widget_burned_icon_dark" />
            <TextView
                android:id="@+id/widget_burned_value"
                style="@style/WidgetValueRow"
                android:textColor="#FBE9E9" />
            <TextView
                    android:id="@+id/widget_burned_net"
                    style="@style/WidgetPill"
                    android:background="@drawable/widget_pill_deficit_dark"
                    android:textColor="#702D32" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="4dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/widget_carbs_card"
            style="@style/WidgetMacro"
            android:layout_marginEnd="6dp"
            android:background="@drawable/widget_card_carbs_dark">
            <TextView
                android:id="@+id/widget_carbs_value"
                style="@style/WidgetMacroValueCompact"
                android:textColor="#E3F1FF" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_protein_card"
            style="@style/WidgetMacro"
            android:layout_marginEnd="6dp"
            android:background="@drawable/widget_card_protein_dark">
            <TextView
                android:id="@+id/widget_protein_value"
                style="@style/WidgetMacroValueCompact"
                android:textColor="#FFF1D9" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_fat_card"
            style="@style/WidgetMacro"
            android:background="@drawable/widget_card_fat_dark">
            <TextView
                android:id="@+id/widget_fat_value"
                style="@style/WidgetMacroValueCompact"
                android:textColor="#F1EAFF" />
        </LinearLayout>
    </LinearLayout>

    <include layout="@layout/widget_actions_five_compact" />
</LinearLayout>
