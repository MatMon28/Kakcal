<?xml version="1.0" encoding="utf-8"?>
<!--
  Fully transparent icon for the system launch screen (see AppTheme.NoActionBarLaunch).
  The Android launch screen needs *an* icon; without one Android 12+ falls back to the
  launcher logo. This blank one lets the in-app animated intro be the only thing the
  user sees. Do not add paths here.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24" />
