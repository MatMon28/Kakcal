{
  "appId": "com.kcalsync.app",
  "appName": "Kakcal",
  "webDir": "dist",
  "server": {
    "androidScheme": "https"
  },
  "plugins": {
    "LocalNotifications": {
      "smallIcon": "ic_stat_kak",
      "iconColor": "#0B0F1E"
    },
    "SystemBars": {
      "insetsHandling": "native",
      "initialViewportFitValueHint": "cover"
    }
  },
  "android": {
    "backgroundColor": "#EFE9DD",
    "allowMixedContent": false,
    "webContentsDebuggingEnabled": false
  }
}
