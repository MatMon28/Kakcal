+
+            <TextView
+                android:id="@+id/widget_intake_value"
+                style="@style/WidgetValue"
+                android:textColor="#E6F8EB" />
+
+            <ProgressBar
+                android:id="@+id/widget_intake_bar"
+                style="?android:attr/progressBarStyleHorizontal"
+                android:layout_width="match_parent"
+                android:layout_height="6dp"
+                android:layout_marginTop="4dp"
+                android:indeterminate="false"
+                android:max="100"
+                android:progress="0"
+                android:progressBackgroundTint="#33FFFFFF"
+                android:progressTint="#C9EFD3" />
+        </LinearLayout>
+
+        <LinearLayout
+            android:id="@+id/widget_burned_card"
+            style="@style/WidgetCard"
+            android:layout_width="0dp"
+            android:layout_weight="1"
+            android:background="@drawable/widget_card_burned_dark">
+
+            <LinearLayout style="@style/WidgetCardHeader">
+                <ImageView
+                    android:layout_width="18dp"
+                    android:layout_height="18dp"
+                    android:importantForAccessibility="no"
