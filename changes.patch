   box-shadow: 0 6px 16px rgb(36 32 28 / 8%);
   backdrop-filter: blur(6px);
 }
 
+/*
+ * The pill follows the shape of its buttons (same rule as the native tray): concentric, i.e. the
+ * button radius / chamfer plus the 8 px vertical padding. Round styles keep the full pill.
+ */
+html[data-style='minimal'] .quick-widget { --widget-pill-radius: 19px; } /* 11px buttons + 8px */
+html[data-style='mono'] .quick-widget { --widget-pill-radius: 20px; } /* 12px buttons + 8px */
+html[data-style='angular'] .quick-widget {
+  --widget-pill-radius: 0;
+  /* 9px button chamfer + 8px * (2 - sqrt 2) = 14px. The border and shadow would be cut by the clip. */
+  --widget-pill-clip: polygon(0 0, calc(100% - 14px) 0, 100% 14px, 100% 100%, 14px 100%, 0 calc(100% - 14px));
+  border-color: transparent;
+  box-shadow: none;
+}
+
 .widget-actions {
   display: flex;
   align-items: center;
