{
  "name": "kakcal",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "android:prepare": "node scripts/check-widget-layouts.mjs && node scripts/prepare-android.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src vite.config.ts",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm run test && vite build",
    "test:browser": "node scripts/smoke.mjs && node scripts/check-journal.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.2",
    "@capacitor/local-notifications": "^8.3.1",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@fontsource/chakra-petch": "^5.3.0",
    "@fontsource/nunito": "^5.3.0",
    "clsx": "2.1.1",
    "lucide-react": "^1.76.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tailwind-merge": "3.4.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.2",
    "@eslint/js": "^9.39.5",
    "@tailwindcss/vite": "4.1.17",
    "@testing-library/react": "^16.3.3",
    "@types/node": "22.19.17",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.1",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fake-indexeddb": "^6.2.8",
    "globals": "^17.14.0",
    "jsdom": "^29.1.1",
    "playwright": "^1.65.1",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.74.0",
    "vite": "7.3.7",
    "vitest": "^4.1.12"
  },
  "description": "Kakcal: a local-first nutrition, activity and wellness journal (React, Vite, Capacitor)"
}
