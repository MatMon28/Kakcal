{
  "id": "./",
  "name": "Kakcal — Daily Nutrition & Wellness",
  "short_name": "Kakcal",
  "description": "A local-first nutrition, activity and wellness journal. No account, no backend; your data stays on this device.",
  "start_url": "./?view=app&source=pwa",
  "scope": "./",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "portrait",
  "background_color": "#EFE9DD",
  "theme_color": "#EFE9DD",
  "lang": "en",
  "dir": "ltr",
  "categories": ["health", "fitness", "food", "lifestyle"],
  "prefer_related_applications": false,
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    {
      "name": "Open my journal",
      "short_name": "Journal",
      "description": "Jump straight into today's journal",
      "url": "./?view=app&source=shortcut",
      "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    }
  ]
}
